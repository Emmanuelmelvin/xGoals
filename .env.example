# xGoal environment variables
# Copy this file to .env or .env.local and replace the placeholders.

# -----------------------------------------------------------------------------
# Supabase Auth — required for Continue with X
# -----------------------------------------------------------------------------
# Safe to expose to the browser.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
VITE_SUPABASE_AUTH_REDIRECT_URL="http://127.0.0.1:3000/auth/callback"


# Server-only Supabase key. Never prefix this with VITE_ and never commit it.
SUPABASE_SECRET_KEY="sb_secret_YOUR_SERVER_ONLY_KEY"

# Local app and OAuth redirect URLs.
APP_URL="http://127.0.0.1:3000"
VITE_SUPABASE_AUTH_REDIRECT_URL="http://127.0.0.1:3000/auth/callback"

# Provider callback URL to register in the X Developer Console.
SUPABASE_AUTH_CALLBACK_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback"

# -----------------------------------------------------------------------------
# X OAuth 2.0 — configure these values in Supabase Dashboard >
# Authentication > Sign In / Providers > X / Twitter (OAuth 2.0).
# They are not used by the browser and must never be prefixed with VITE_.
# -----------------------------------------------------------------------------
X_CLIENT_ID="your-x-oauth-client-id"
X_CLIENT_SECRET="your-x-oauth-client-secret"

# Optional: only needed when xGoal begins reading or publishing through X API.
X_OAUTH_SCOPES="users.read tweet.read offline.access"

# -----------------------------------------------------------------------------
# Supabase database — optional until server-side database tooling is added.
# -----------------------------------------------------------------------------
SUPABASE_DB_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# Future agent infrastructure — optional until the agent backend is enabled.
# -----------------------------------------------------------------------------
AGENT_API_URL="http://127.0.0.1:8000"
AI_PROVIDER="ollama"
# Supported values: ollama, bedrock, openai, groq.
AI_TEMPERATURE="0.2"
AI_LOG_LEVEL="INFO"

OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
BEDROCK_MODEL_ID="global.anthropic.claude-sonnet-4-6"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4"
OPENAI_BASE_URL=""

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Optional: Sentry error monitoring
SENTRY_DSN=""
VITE_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Optional: PostHog analytics
VITE_POSTHOG_KEY=""
POSTHOG_API_KEY=""
